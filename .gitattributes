# Dataset hashes and the generator-reproducibility test are computed over raw file BYTES, so these files
# must keep LF line endings on every platform (Windows Git defaults to autocrlf=true, which would
# rewrite them to CRLF and change every dataset hash).
* text=auto eol=lf
*.jsonl text eol=lf
*.json text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
